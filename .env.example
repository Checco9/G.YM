# Connessione Postgres (es. Neon, usa la stringa "pooled")
DATABASE_URL=postgres://user:password@host/ghisa?sslmode=require

# Facoltativo: se impostato, serve per registrarsi (utile su un'istanza pubblica)
REGISTRATION_CODE=

# Facoltativo: origine pubblica dell'app, usata per il controllo CSRF
# (se vuoto si confronta Origin con l'header Host)
APP_ORIGIN=

# ── Foto dei post (facoltativo: senza queste i post funzionano, solo senza foto) ──
# Project URL e chiave "service_role" da Supabase > Project Settings > API. La chiave è SEGRETA: solo sul server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nome del bucket pubblico (viene creato da solo al primo upload)
SUPABASE_BUCKET=post-photos

# Facoltativa: connessione diretta per le migrazioni, se il pooler desse problemi
MIGRATION_DATABASE_URL=
